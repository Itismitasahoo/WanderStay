
  <% layout("/layouts/boilerplate") %><%= success %>
  <body>

    <style>

      .listing-link{
  text-decoration: none;
  color: inherit;
}

.listing-link:hover{
  color: inherit;
}


.listing-link .card-text,
.listing-link .card-text b {
    color: var(--text-color);
}



/* Homepage Filters */
#filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.5rem;
}

.filter {
  text-align: center;
  margin-top: 1rem;
  opacity: 0.8;
  text-decoration: none;
  color: inherit;
}

.filter:hover {
  opacity: 1;
  cursor: pointer;
  color: inherit;
}

.filter p {
  font-size: 0.8rem;
}

/* Right-side controls */
.filter-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-left: auto;
  flex-wrap: wrap;
}

/* Tax Toggle */
.tax-toggle {
  border: 1px solid var(--border-color);
  border-radius: 1rem;
  min-height: 2.8rem;
  padding: 0.6rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background-color: var(--card-bg);
  color: var(--text-color);
  margin: 0;
}

/* Recently Viewed Button */
.recently-viewed-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 2.8rem;
  padding: 0.6rem 1rem;
  border: 1px solid var(--border-color);
  border-radius: 1rem;
  background-color: var(--card-bg);
  color: var(--text-color);
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.recently-viewed-btn:hover {
  background-color: var(--footer-bg);
  color: var(--text-color);
  border-color: var(--text-color);
  transform: translateY(-1px);
}

/* Dark Theme */
html[data-theme="dark"] #filters .filter {
  color: var(--text-color);
}

html[data-theme="dark"] #filters .filter:hover {
  color: var(--text-color);
}

html[data-theme="dark"] .tax-toggle,
html[data-theme="dark"] .recently-viewed-btn {
  background-color: var(--card-bg);
  color: var(--text-color);
  border-color: var(--border-color);
}

html[data-theme="dark"] .recently-viewed-btn:hover {
  background-color: #34383b;
  color: #ffffff;
}

/* Mobile Layout */
@media (max-width: 768px) {
  #filters {
    gap: 1rem;
  }

  .filter-actions {
    margin-left: 0;
    width: 100%;
  }
}

      .tax-info{
        display: none;
      }

      .tax-toggle{
        border: 1px solid black;
        border-radius: 1rem;
        height: 2.8rem;
        padding: 1rem;
        margin-left:2rem ;
        display: flex;
        align-items: center;
        background-color: var(--card-bg);
color: var(--text-color);
border-color: var(--border-color);
      }

      .listing-card{
  position: relative;
}

.favorite-form{
  position:absolute;
  top:10px;
  right:10px;
  z-index:100;
}

.favorite-btn{
  border:none;
  background:white;
  width:35px;
  height:35px;
  border-radius:50%;
  cursor:pointer;
  font-size:18px;
  box-shadow:0 2px 8px rgba(0,0,0,0.2);
}

html[data-theme="dark"] #filters .filter {
    color: var(--text-color);
}

html[data-theme="dark"] #filters .filter:hover {
    color: var(--text-color);
}


    </style>
