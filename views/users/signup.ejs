<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <h2 class="col-6 offset-3">Signup on Wanderlust</h2>
  <div class="col-6 offset-3">
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <lebel for="username" class="form-level">Username</lebel>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          required
        />
      </div>

      <div class="mb-3">
        <lebel for="email" class="form-level">Email</lebel>
        <input
          name="email"
          id="email"
          type="email"
          class="form-control"
          required
        />
      </div>

      <div class="mb-3">
        <lebel for="password" class="form-lebel">Password</lebel>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          required
        />
      </div>
      <button class="btn btn-success">Signup</button>
    </form>
  </div>
</div>
